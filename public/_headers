# Cache Headers Configuration
#
# GitHub Pages does not support custom cache headers via _headers files.
# Since this site is served through Cloudflare (custom domain: igrs.madeby.my.id),
# configure these as Cloudflare Cache Rules / Transform Rules on the zone:
#   Dashboard → madeby.my.id → Rules → Cache Rules (Cache-Control below)
#   Dashboard → madeby.my.id → Rules → Transform Rules → Modify Response Header
#     (security headers below)
#
# This file documents the intended policy and can be used directly if the
# site is migrated to Cloudflare Pages (which honors _headers natively).

# Accepted risk (2026-08): style-src 'unsafe-inline' stays because TanStack
# Virtual row transforms and tooltip positioning need inline style attributes;
# see SECURITY.md threat-model note. When CF_BEACON_TOKEN is set at build
# time, also add https://static.cloudflareinsights.com to script-src (and
# https://cloudflareinsights.com to connect-src).

/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.bunny.net; font-src https://fonts.bunny.net; img-src 'self' https: data:; connect-src 'self' https://cors.mefi.workers.dev; form-action 'self'; upgrade-insecure-requests
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Hashed assets (JS, CSS, images with content hashes in filenames)
# These are immutable — the filename changes when content changes.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

/assets/data/images/*
  Cache-Control: public, max-age=31536000, immutable

# HTML files — always revalidate to ensure users get the latest version
/*.html
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/404.html
  Cache-Control: no-cache

/ratings/index.html
  Cache-Control: no-cache

/search/index.html
  Cache-Control: no-cache

/steamchecker/index.html
  Cache-Control: no-cache

# JSON data files — shorter TTL since data updates periodically
/assets/data/json/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# i18n dictionaries — moderate TTL, changes infrequently
/assets/i18n/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
